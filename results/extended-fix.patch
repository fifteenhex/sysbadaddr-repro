diff --git a/arch/m68k/lib/uaccess.c b/arch/m68k/lib/uaccess.c
index 80c76c4e6c32..d2dcaa1d2a3f 100644
--- a/arch/m68k/lib/uaccess.c
+++ b/arch/m68k/lib/uaccess.c
@@ -70,6 +70,26 @@ unsigned long __generic_copy_to_user(void __user *to, const void *from,
 {
 	unsigned long tmp, res;
 
+	/*
+	 * Align the user destination to a longword boundary first.  A MOVES
+	 * store that straddles a page boundary commits the bytes landing in the
+	 * mapped page and then faults on the unmapped one.  On the 68040 that
+	 * partial store becomes a pending writeback which do_040writebacks()
+	 * replays through put_user(); that replay cannot be unwound back into
+	 * the copy's EFAULT and oopses.  On the 68030 the straddling fault is
+	 * reported with a PC past the MOVES, so the exception table is missed
+	 * and it oopses too.  A longword-aligned store lies wholly within one
+	 * page, so it either completes or faults cleanly and the existing
+	 * exception-table fixup returns the right byte count on every CPU.
+	 */
+	while (n && ((unsigned long)to & 3)) {
+		if (__put_user(*(const char *)from, (char __user *)to))
+			return n;
+		to = (char __user *)to + 1;
+		from = (const char *)from + 1;
+		n--;
+	}
+
 	asm volatile ("\n"
 		"	tst.l	%0\n"
 		"	jeq	4f\n"
